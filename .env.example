# URL base del API REST.
# En GitHub Pages se usa la API estática generada en /api.
VITE_API_URL=/api

# Puerto del backend Express en desarrollo.
API_PORT=3001

# Origen permitido por CORS. Si se omite, se acepta cualquier origen.
# CORS_ORIGIN=http://localhost:5173

# Retardo artificial en milisegundos para probar el estado de carga.
# API_DELAY_MS=0
